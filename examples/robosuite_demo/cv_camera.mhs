      "name": "yellow block Y",
      "datatype": "number",
      "unit": "m",
      "nominal_range": {
        "min": -0.6,
        "max": 0.6
      },
      "accuracy": 0.035,
      "sample_rate_hz": 20.0
    },
    {
      "id": "yellow_block_z",
      "name": "yellow block Z",
      "datatype": "number",
